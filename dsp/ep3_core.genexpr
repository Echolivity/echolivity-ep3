// =====================================================================
// ECHOLIVITY — EP-3 (Maestro Echoplex EP-3 model) · tape engine v0.1.2-dev
// v0.1.2-dev: identifiers renamed that collide with gen~ built-ins (dcblock -> dc_block,
// lt -> l_t); no functional change (bit-identical, test R06/X01).
// v0.1.1-dev remediation (see CHANGELOG / validation/EP3_REMEDIATION_REPORT.md): F1 HOLD loop gain,
// F2 33 nF feedback runaway, F3 8 s default loop, F4 click-free DE-EMPH / Cable / Source-cap
// changes, F6 loop-length change fade.
// gen~ codebox. Status of every value: docs/EP3_MODELING_NOTES.md
//
// Signal flow (EP-3 manual, Maestro owner/service manual [S1]):
//   input -> Q5 FET stage (TIS58, 22k drain, 3.3k source, 0.022 uF source
//   bypass = pre-emphasis) -> dry out (high output Z into cable C)
//                           -> record level -> record amp -> RECORD/ERASE HEAD
//   (moving, on the slider) -> tape (8 ips, ~75 ft loop) -> fixed ECHO head
//   -> head amp + de-emphasis -> Echo Sustain (feedback) / Echo Volume (blend
//   pot in the passive output mixer, wiper grounded) -> output (high Z, into the cable)
//   SOS: SOS head (upstream of the record head) monitors the loop; erase off,
//   new material is added to the old layer (-1 dB per pass, manual alignment).
//
// The record head moves, so a slider move changes how sound is WRITTEN on the
// tape (pitch change heard one delay later). The write is band-limited (pre-
// write low-pass that follows the head's speed over the tape, after
// Arnardottir/Abel/Smith 2008) and fills every tape cell the head crosses.
//
// Tape buffer: fixed 48 000 cells per second of tape at nominal speed, so the
// 112.5 s loop costs the same memory at any sample rate.
// Level convention: 100 mV == -18 dBFS RMS (same as the H&H device).
// Mono like the original: L+R are summed at the input; out1 == out2.
//
// out1/out2: audio   out3: delay (ms)   out4: tap BPM
// out5: record-head write speed over tape (1 = normal)   out6: tape speed
// out7: output-protection gain   out8: output over flag
// =====================================================================

// ---------- stateful helpers (each call site gets its own state) ------
svf(x, fc, q) {
	History s1(0);
	History s2(0);
	History key_fc(-1);
	History key_q(-1);
	History key_sr(-1);
	History c_k(0);
	History c_a1(0);
	History c_a2(0);
	History c_a3(0);
	if (fc != key_fc || q != key_q || samplerate != key_sr) {
		fcc = clamp(fc, 5, samplerate * 0.49);
		g = tan(pi * fcc / samplerate);
		c_k = 1 / q;
		c_a1 = 1 / (1 + g * (g + c_k));
		c_a2 = g * c_a1;
		c_a3 = g * c_a2;
		key_fc = fc;
		key_q = q;
		key_sr = samplerate;
	}
	v3 = x - s2;
	v1 = c_a1 * s1 + c_a2 * v3;
	v2 = s2 + c_a2 * s1 + c_a3 * v3;
	s1 = fixdenorm(2 * v1 - s1);
	s2 = fixdenorm(2 * v2 - s2);
	return v2, v1, x - c_k * v1 - v2;
}

lp1(x, fc) {
	History z(0);
	History key_fc(-1);
	History key_sr(-1);
	History c_a(0);
	if (fc != key_fc || samplerate != key_sr) {
		c_a = 1 - exp(-twopi * min(fc, samplerate * 0.49) / samplerate);
		key_fc = fc;
		key_sr = samplerate;
	}
	z = fixdenorm(z + c_a * (x - z));
	return z;
}

hp1(x, fc) {
	return x - lp1(x, fc);
}

dc_block(x) {
	History x1(0);
	History y1(0);
	R = 1 - twopi * 10 / samplerate;
	y = fixdenorm(x - x1 + R * y1);
	x1 = x;
	y1 = y;
	return y;
}

hermite(xm1, x0, x1, x2, f) {
	c1 = 0.5 * (x1 - xm1);
	c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2;
	c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
	return ((c3 * f + c2) * f + c1) * f + x0;
}

softclip(x, k, c) {
	ax = abs(x);
	y = x;
	if (ax > k) {
		sg = (x >= 0) ? 1 : -1;
		y = sg * (k + (c - k) * tanh((ax - k) / (c - k)));
	}
	return y;
}

tapesat(x, b) {
	History key_b(-99999);
	History c_tb(0);
	if (b != key_b) {
		c_tb = tanh(b);
		key_b = b;
	}
	tb = c_tb;
	return (tanh(x + b) - tb) / (1 - tb * tb);
}

psmooth(t, a) {
	History s(0);
	History init(0);
	if (init < 0.5) {
		s = t;
		init = 1;
	}
	s = s + a * (t - s);
	if (abs(t - s) <= 0.000000001 * max(1, abs(t))) {
		s = t;
	}
	return s;
}

fsmooth(f, a) {
	History ls(0);
	History init(0);
	l_t = log(f);
	if (init < 0.5) {
		ls = l_t;
		init = 1;
	}
	ls = ls + a * (l_t - ls);
	if (abs(l_t - ls) <= 0.000000001) {
		ls = l_t;
	}
	return (ls == l_t) ? f : exp(ls);
}

// JFET drain current, square law: Id = Idss (1 - Vgs/Vp)^2 for Vp < Vgs, else 0.
// Vgs above +0.4 V is held there (gate-source diode conducts).
// Source node: Rs in parallel with Cs (Cs = 0 when the bypass cap is out).
// Backward-Euler step for the source node, solved in closed form:
//   (Cs/dt + 1/Rs) Vs - (Cs/dt) Vs0 = Id(vg - Vs)
// Returns (Id, Vs).
fet_step(vg, vs0, cdt, rs, idss, vp) {
	a = cdt + 1 / rs;
	b = cdt * vs0;
	vgc = min(vg, 0.4 + vs0);
	// w = 1 - Vgs/Vp; Vs = Vp w - Vp + vg  ->  idss w^2 - a Vp w + (a Vp - a vg + b) = 0
	qa = idss;
	qb = -a * vp;
	qc = a * vp - a * vgc + b;
	disc = qb * qb - 4 * qa * qc;
	idq = 0;
	vsq = b / a;                                  // cut-off: no drain current
	if (disc >= 0) {
		w = (-qb + sqrt(disc)) / (2 * qa);
		if (w > 0) {
			idq = idss * w * w;
			vsq = vp * w - vp + vgc;
		}
	}
	return idq, vsq;
}

// Passive output mixer (EP-3; values from replica/forum traces [S11][S13]-[S15], APPROX until a
// clean schematic): drain -0.1uF- A; A -470k- gnd; A -220k- B; B = Echo Volume lug 1;
// B -100k- OUT. Echo amp -220k- E; E -100k- gnd; E = pot lug 3; E -100k- OUT.
// The 500k pot's WIPER IS GROUNDED: k = 0 shorts the echo lug, k = 1 shorts the dry lug,
// so Echo Volume is a blend and the dry level peaks near k = 0.2 (non-monotonic).
// OUT drives the amp (1M) and the cable capacitance. Returns dry gain, echo gain and the
// Thevenin resistance at OUT (which, with the cable C, sets the treble roll-off).
mixer(k) {
	rp3 = clamp(k, 0, 1) * 500000;
	rp1 = 500000 - rp3;
	ra = 22000 * 470000 / 492000;
	vbf = (470000 / 492000) * rp1 / (ra + 220000 + rp1);
	rdb = (ra + 220000) * rp1 / (ra + 220000 + rp1) + 100000;
	rsh = rp3 * 100000 / (rp3 + 100000);
	vef = rsh / (220000 + rsh);
	reb = 220000 * rsh / (220000 + rsh) + 100000;
	gsum = 1 / rdb + 1 / reb + 0.000001;
	return vbf / rdb / gsum, vef / reb / gsum, 1 / gsum;
}

// F1/F2 (v0.1.1): peak gain of the fixed playback/record loop chain for a de-emphasis corner fde:
// tape HF loss (2-pole, 5188 Hz) x de-emphasis (1-pole fde, normalised to 1 at 1 kHz)
// x couplings (30, 20, 10 Hz high-passes). The 1 kHz normalisation lifts the chain above 1 below
// 1 kHz: peak 1.043 (334 Hz) for 3 nF and 3.383 (102 Hz) for 33 nF, matching measured per-pass
// gains of 1.040 / 3.369 (validation/EP3_REMEDIATION_REPORT.md). Grid search, 20 Hz–4 kHz.
loop_peak(fde) {
	nrm = sqrt(1 + (1000 / fde) * (1000 / fde));
	pk = 0;
	for (i = 0; i < 96; i += 1) {
		f = 20 * pow(200, i / 95);
		gtp = 1 / sqrt(1 + pow(f / 5188, 4));
		gd = nrm / sqrt(1 + (f / fde) * (f / fde));
		g30 = (f / 30) / sqrt(1 + (f / 30) * (f / 30));
		g20 = (f / 20) / sqrt(1 + (f / 20) * (f / 20));
		g10 = (f / 10) / sqrt(1 + (f / 10) * (f / 10));
		pk = max(pk, gtp * gd * g30 * g20 * g10);
	}
	return pk;
}

// ---------- tape ------------------------------------------------------
// 112.5 s * 48 000 cells/s (+ margin)
Data tape(5400064, 1);

// ---------- parameters ------------------------------------------------
Param in_gain_db(0, min=-36, max=12);
Param dry(1, min=0, max=1);                  // Echolivity trim on the dry branch (1 = original)
Param echo(0.5, min=0, max=1);               // ECHO VOLUME: the 500k blend pot (wiper grounded)
Param echo_trim_db(0, min=-24, max=12);      // Echolivity trim on the echo branch
Param out_db(0, min=-36, max=12);
Param mode(2, min=0, max=2);
Param bpm(120, min=20, max=999);
Param sync_div(2, min=0, max=5);
Param sync_type(0, min=0, max=2);
Param sync_mult(1, min=1, max=8);
Param offset_ms(0, min=-100, max=100);
Param tap(0, min=0, max=1000000);
Param tap_div(3, min=0, max=5);
Param tap_type(0, min=0, max=2);
Param bar_beats(4, min=1, max=16);
// ECHO DELAY slider: delay is linear in head position at constant tape speed.
// 60–600 ms default = DAFX/CCRMA measured range [S3]; 80–800 per [S4].
Param slider_pos(0.5, min=0, max=1);
Param slider_min_ms(60, min=2, max=2000);
Param slider_max_ms(600, min=2, max=4000);
Param glide_ms(40, min=1, max=2000);
Param transition_ms(250, min=1, max=4000);
Param head_slew(4, min=0.05, max=12);        // max head speed, in delay-seconds per second (APPROX)
// EP-3 front panel / internal
Param sustain(0.4, min=0, max=1);            // ECHO SUSTAIN (500k lin [S12]); runs away from 0.8 (test E14)
Param rec_db(0, min=-12, max=12);            // RECORD LEVEL trimmer (internal on the original)
Param sos(0, min=0, max=1);                  // ECHO / SOUND ON SOUND switch
Param sos_db(-1, min=-6, max=0);             // SOS loss per pass; manual alignment: "approximately 1dB"
Param echo_on(1, min=0, max=1);              // footswitch: echo on/off
Param playback(0, min=0, max=1);             // footswitch: playback (record + erase off)
Param pre_bypass(1, min=0, max=1);           // Q5 source bypass 0.022 uF (manual addendum) in/out
Param cable_pf(470, min=0, max=2000);        // cable + amp input capacitance; 470 pF fits ClinchFX's descriptions (test E07)
Param pb_eq(0, min=0, max=1);                // de-emphasis: 0 = 18k/0.003uF (forum), 1 = 18k/0.033uF (manual scan)
Param bias_khz(100, min=40, max=120);        // "approximate frequency of 100 KC" [S1]
Param bias_leak(0.3, min=0, max=1);          // bias heard on very fast slider moves (APPROX level)
Param loop_s(8, min=1, max=112.5);           // F3 (v0.1.1): default 8 s for usable SOS/PLAYBACK; 112.5 s = ~75 ft at 8 ips [S18] (authentic)
// tape character (Echolivity)
Param sat(0.5, min=0, max=1);
Param noise_db(-60, min=-120, max=-30);
Param wow(0.1, min=0, max=1);                // slow drift
Param flutter(0.25, min=0, max=1);           // 0.5 stays within the 0.3 % spec (E10: 0.256 %); capstan 26 Hz, pinch 2.5/5 Hz
// performance (Echolivity)
Param hold(0, min=0, max=1);
Param hold_fb(1, min=0.9, max=1.05);
Param drive(0, min=0, max=1);
Param drive_db(12, min=0, max=24);
Param drive_fb(0, min=0, max=1);
Param tape_stop(0, min=0, max=1);
Param stop_time(1, min=0.05, max=8);
Param start_time(0.4, min=0.05, max=8);
Param fb_hp_hz(10, min=10, max=2000);
Param fb_lp_hz(20000, min=500, max=20000);
Param fb_res(0, min=0, max=1);
Param echo_hp_hz(10, min=10, max=2000);
Param echo_lp_hz(20000, min=500, max=20000);
Param protect(1, min=0, max=1);
Param ceiling_db(-0.3, min=-12, max=0);

// ---------- state -----------------------------------------------------
History p(0);
History d_head(-1);
History Ts1(-1);
History Ts2(-1);
History w_prev(0);
History rec_prev(0);
History first(1);
History s_stop(1);
History hold_s(0);
History drive_s(0);
History sos_s(0);
History echo_on_s(1);
History echo_on_s2(1);
History pb_s(0);
History env(0);
History prev_mode(-1);
History trans_left(0);
History nsamp(0);
History tap_prev(0);
History last_tap(-1);
History t_count(0);
History ti0(0);
History ti1(0);
History ti2(0);
History ti3(0);
History tap_bpm(120);
History ph_cap(0);
History ph_p1(0);
History ph_p2(0);
History drift(0);
History fl_rnd(0);
History last_sr(0);
History vs_state(-1);
History pg_hold(1);
History pg_s(1);
History ph_cnt(0);
History u_out(1);
History ck_pk3(-1);
History ck_pk33(-1);
History L_cur(-1);
History hp_env(0);
History hold_tgt(0);
History hold_c(1);
History hold_prev(0);
History hold_cnt(0);
History hold_pass(0);
History hold_np(0);
History hold_elast(0);
History lg(1);
History lg1(1);
History lg_t(1);
History lg_hold(0);
// cached coefficients
History ck_sr(-1);
History ck_ps(0);
History ck_a10(0);
History ck_drift(0);
History ck_flr(0);
History ck_nnorm(1);
History ck_up(0);
History ck_dn(0);
History ck_prel(0);
History ck_patt(0);
History ck_tau(-1);
History ck_as(0);
History ck_fkey(-99999);
History ck_idq(0);
History ck_vsq(0);
History ck_dkey(-99999);
History ck_dg(1);
History ck_sat(-99999);
History ck_gt(1);
History ck_ing(-99999);
History ck_ig(1);
History ck_rkey(-99999);
History ck_rg(1);
History ck_skey(-99999);
History ck_sg(0.891);
History ck_nkey(-99999);
History ck_ng(0);
History ck_okey(-99999);
History ck_kkey(-99999);
History ck_gd(0.18);
History ck_ge(0.13);
History ck_rth(83000);
History ck_en(1);
History ck_etkey(-99999);
History ck_et(1);
History ck_og(1);
History ck_ckey(-99999);
History ck_cl(1);

CR = 48000;                                  // tape cells per second at nominal speed
NB = 5400064;
VPF = 0.794;                                 // volts per full scale (100 mV = -18 dBFS RMS)
RD = 22000;                                  // Q5 drain resistor [S1][S8]
RS = 3300;                                   // Q5 source resistor [S1]
CS = 0.000000022;                            // Q5 source bypass [S1 addendum]
IDSS = 0.0034;                               // APPROX: fitted so Vs = 1.8 V at 21.2 V supply
VP = -3.0;                                   //   (measured 1.72–1.88 V / 21.0–21.3 V on two units [S8])
VDD = 21.2;
FBIAS_MIN_SP = 0.45;                         // spatial Nyquist guard (cycles per tape cell)

sr = samplerate;
t = nsamp;
nsamp = nsamp + 1;
x = 0.5 * (fixnan(in1) + fixnan(in2));      // mono, like the original

if (sr != last_sr) {
	if (last_sr > 0) {
		Ts1 = -1;
		Ts2 = -1;
		d_head = -1;
		last_tap = -1;
		t_count = 0;
	}
	last_sr = sr;
}

// ================= TAP TEMPO (sample counter; as the H&H device) =======
if (tap > tap_prev + 0.5) {
	if (last_tap >= 0) {
		iv = t - last_tap;
		if (iv < 0.15 * sr) {
			iv = -1;
		} else if (iv > 2 * sr) {
			t_count = 0;
			last_tap = t;
		} else {
			if (t_count > 0) {
				tavg0 = (ti0 + ti1 + ti2 + ti3) / min(t_count, 4);
				if (abs(iv - tavg0) > 0.4 * tavg0) {
					t_count = 0;
				}
			}
			ti3 = ti2;
			ti2 = ti1;
			ti1 = ti0;
			ti0 = iv;
			if (t_count == 0) {
				ti1 = 0;
				ti2 = 0;
				ti3 = 0;
			}
			t_count = min(t_count + 1, 4);
			tavg = (ti0 + ti1 + ti2 + ti3) / t_count;
			tap_bpm = 60 * sr / tavg;
			last_tap = t;
		}
	} else {
		last_tap = t;
	}
}
tap_prev = tap;

// ================= TARGET DELAY TIME ==================================
s_lo = min(slider_min_ms, slider_max_ms);
s_hi = max(slider_min_ms, slider_max_ms);
T = (s_lo + slider_pos * (s_hi - s_lo)) * 0.001;
if (mode < 1.5) {
	use_bpm = max(bpm, 20);
	dv_idx = floor(sync_div + 0.5);
	typ = floor(sync_type + 0.5);
	if (mode >= 0.5) {
		use_bpm = tap_bpm;
		dv_idx = floor(tap_div + 0.5);
		typ = floor(tap_type + 0.5);
	}
	beats = 0.125;
	if (dv_idx == 1) { beats = 0.25; }
	else if (dv_idx == 2) { beats = 0.5; }
	else if (dv_idx == 3) { beats = 1; }
	else if (dv_idx == 4) { beats = 2; }
	else if (dv_idx >= 5) { beats = bar_beats; }
	if (typ == 1) { beats = beats * 1.5; }
	else if (typ == 2) { beats = beats * 2 / 3; }
	T = 60 / use_bpm * beats * max(sync_mult, 1) + offset_ms * 0.001;
}
T = clamp(T, 0.002, 4);

// sample-rate-dependent constants
if (sr != ck_sr) {
	ck_ps = 1 - exp(-1 / (0.010 * sr));
	ck_a10 = ck_ps;
	ck_drift = 1 - exp(-twopi * 0.5 / sr);
	ck_flr = 1 - exp(-twopi * 20 / sr);
	a_n0 = 1 - exp(-twopi * min(10000, 0.49 * sr) / sr);
	ck_nnorm = sqrt((1 / 3) * a_n0 / (2 - a_n0));
	ck_up = 1 - exp(-1 / (0.001 * sr));
	ck_dn = 1 - exp(-1 / (0.200 * sr));
	ck_prel = 1 - exp(-1 / (0.150 * sr));
	ck_patt = 1 - exp(-1 / (0.0005 * sr));
	ck_sr = sr;
	ck_tau = -1;
	ck_fkey = -99999;
	ck_nkey = -99999;
}

// smoothed continuous parameters
sm_in_gain_db = psmooth(in_gain_db, ck_ps);
sm_dry = psmooth(dry, ck_ps);
sm_echo = psmooth(echo, ck_ps);
sm_echo_trim_db = psmooth(echo_trim_db, ck_ps);
sm_out_db = psmooth(out_db, ck_ps);
sm_sustain = psmooth(sustain, ck_ps);
sm_rec_db = psmooth(rec_db, ck_ps);
sm_sos_db = psmooth(sos_db, ck_ps);
sm_bias_leak = psmooth(bias_leak, ck_ps);
sm_sat = psmooth(sat, ck_ps);
sm_noise_db = psmooth(noise_db, ck_ps);
sm_wow = psmooth(wow, ck_ps);
sm_flutter = psmooth(flutter, ck_ps);
sm_hold_fb = psmooth(hold_fb, ck_ps);
sm_drive_db = psmooth(drive_db, ck_ps);
sm_fb_res = psmooth(fb_res, ck_ps);
sm_cable_pf = psmooth(cable_pf, ck_ps);
sm_bias_khz = fsmooth(bias_khz, ck_ps);
sm_fb_hp_hz = fsmooth(fb_hp_hz, ck_ps);
sm_fb_lp_hz = fsmooth(fb_lp_hz, ck_ps);
sm_echo_hp_hz = fsmooth(echo_hp_hz, ck_ps);
sm_echo_lp_hz = fsmooth(echo_lp_hz, ck_ps);
// ceiling_db is not smoothed (see H&H test P05)

if (mode != prev_mode) {
	if (prev_mode >= 0) {
		trans_left = transition_ms * 0.001 * sr * 3;
	}
	prev_mode = mode;
}
tau_ms = glide_ms;
if (trans_left > 0) {
	tau_ms = max(transition_ms, glide_ms);
	trans_left = trans_left - 1;
}
if (tau_ms != ck_tau) {
	ck_as = 1 - exp(-1 / (max(tau_ms, 0.5) * 0.001 * sr));
	ck_tau = tau_ms;
}
a_s = ck_as;
Tc = T * CR;                                 // target head distance in tape cells
if (Ts1 < 0) {
	Ts1 = Tc;
	Ts2 = Tc;
}
Ts1 = Ts1 + a_s * (Tc - Ts1);
Ts2 = Ts2 + a_s * (Ts1 - Ts2);

// ================= TRANSPORT ==========================================
if (tape_stop > 0.5) {
	s_stop = max(0, s_stop - 1 / (max(stop_time, 0.02) * sr));
} else {
	s_stop = min(1, s_stop + 1 / (max(start_time, 0.02) * sr));
}
// F6 (v0.1.1): a Loop Length change moves the wrap point, so the heads land on other tape.
// Fade the playback (echo + feedback) out with a smooth 2-stage curve (3 ms stages, ~40 ms to
// silence), apply the new length, keep it muted until freshly recorded tape reaches the echo
// head (one delay + 5 ms: the tape between the heads still holds old material), then fade in.
L_tgt = floor(clamp(loop_s, 1, 112.5) * CR);
if (L_cur < 0) {
	L_cur = L_tgt;
}
lg_t = 1;
if (L_tgt != L_cur) {
	lg_t = 0;
	if (lg < 0.0001) {
		L_cur = L_tgt;
		first = 1;                               // restart the write-head tracking on the new loop
		lg_hold = Ts2 * sr / CR + 0.005 * sr;    // one delay (target head distance) + 5 ms
	}
}
if (lg_hold > 0) {
	lg_t = 0;
	lg_hold = lg_hold - 1;
}
a_lg = 1 - exp(-1 / (0.003 * sr));
lg1 = lg1 + a_lg * (lg_t - lg1);
lg = lg + a_lg * (lg1 - lg);
L = L_cur;

// flutter: capstan 26 Hz, pinch wheel 2.5 / 5.0 Hz (measured on an Echoplex [S5]),
// plus a little broadband flutter and slow drift. flutter = 0.5 -> within the 0.3 % spec (E10: 0.256 % peak).
ph_cap = ph_cap + 26 / sr;
ph_cap = ph_cap - floor(ph_cap);
ph_p1 = ph_p1 + 2.5 / sr;
ph_p1 = ph_p1 - floor(ph_p1);
ph_p2 = ph_p2 + 5.0 / sr;
ph_p2 = ph_p2 - floor(ph_p2);
drift = drift + ck_drift * (noise() * 3 - drift);
fl_rnd = fl_rnd + ck_flr * (noise() * 2 - fl_rnd);
wf = sm_flutter * 0.006 * (0.45 * sin(twopi * ph_cap) + 0.3 * sin(twopi * ph_p1) + 0.15 * sin(twopi * ph_p2) + 0.1 * fl_rnd)
   + sm_wow * 0.005 * drift;

v_eff = clamp(s_stop * (1 + wf), 0, 2);
vc = v_eff * CR / sr;                        // tape cells per sample

// ---- record head position (moving) with a head-speed limit
if (d_head < 0) {
	d_head = Ts2;
}
hs = max(head_slew, 0.05) * CR / sr;         // cells per sample
d_head = d_head + clamp(Ts2 - d_head, -hs, hs);
d = clamp(d_head, 16, L - 64);
// SOS head: fixed just upstream of the slider's far end (APPROX gap 62.5 ms = 0.5 in at 8 ips)
d_sos = clamp((s_hi + 62.5) * 0.001 * CR, d + 1, L - 32);

p_new = wrap(p + vc, 0, L);
w_new = p_new + d;                           // write position (unwrapped relative to p_new)
w_old = w_prev;
if (first > 0.5) {
	w_old = w_new - vc;
	first = 0;
}
// keep w_old in the same unwrapped frame as w_new
if (w_old - w_new > 0.5 * L) {
	w_old = w_old - L;
} else if (w_new - w_old > 0.5 * L) {
	w_old = w_old + L;
}
u_cps = w_new - w_old;                       // head speed over tape, cells per sample
u_out = u_cps / max(CR / sr, 0.000001);      // 1 = normal recording speed

// ================= gates & per-sample coefficients ====================
hold_s = hold_s + ck_a10 * (hold - hold_s);
drive_s = drive_s + ck_a10 * (drive - drive_s);
sos_s = sos_s + ck_a10 * (sos - sos_s);
echo_on_s = echo_on_s + ck_a10 * (echo_on - echo_on_s);
echo_on_s2 = echo_on_s2 + ck_a10 * (echo_on_s - echo_on_s2);   // 2-stage: no corner at the switch
pb_s = pb_s + ck_a10 * (playback - pb_s);
dkey = drive_s * sm_drive_db;
if (dkey != ck_dkey) {
	ck_dg = pow(10, dkey / 20);
	ck_dkey = dkey;
}
drive_gain = ck_dg;
if (sm_sat != ck_sat) {
	ck_gt = 0.6 * pow(4, 2 * (sm_sat - 0.5));  // 0.5: ~2-3 % THD at nominal level (calibration test E05: 2.1 %)
	ck_sat = sm_sat;
}
g_t = ck_gt;
if (sm_in_gain_db != ck_ing) {
	ck_ig = pow(10, sm_in_gain_db / 20);
	ck_ing = sm_in_gain_db;
}
if (sm_rec_db != ck_rkey) {
	ck_rg = pow(10, sm_rec_db / 20);
	ck_rkey = sm_rec_db;
}
if (sm_sos_db != ck_skey) {
	ck_sg = pow(10, sm_sos_db / 20);
	ck_skey = sm_sos_db;
}
if (sm_noise_db != ck_nkey) {
	ck_ng = (sm_noise_db > -119) ? pow(10, sm_noise_db / 20) / ck_nnorm : 0;
	ck_nkey = sm_noise_db;
}
// F1/F2 (v0.1.1): scale by the chain's peak loop gain instead of assuming it is 1.
// Sustain: x (pk3 / pk) keeps the 3 nF behaviour exactly (factor 1.0) and gives 33 nF the
// same peak loop gain (same runaway point). HOLD: / pk makes the per-pass peak gain equal to
// Hold Feedback, so 1.0 holds the loop instead of growing.
if (ck_pk3 < 0) {
	ck_pk3 = loop_peak(2947);
	ck_pk33 = loop_peak(268);
}
pbs = psmooth(pb_eq, ck_ps);                 // F4: de-emphasis switch is crossfaded (10 ms)
pk_loop = (1 - pbs) * ck_pk3 + pbs * ck_pk33;
fb_amt = (sm_sustain * 1.25) * (ck_pk3 / pk_loop) * (1 - hold_s) + (sm_hold_fb / pk_loop) * hold_c * hold_s;
fb_amt = fb_amt * (1 - sos_s);               // ECHO/SUSTAIN not operative in SOS [S1]
q_fb = 0.707 + sm_fb_res * 6;
dfb_g = (drive_fb > 0.5) ? drive_gain : 1;

// ================= Q5 FET INPUT STAGE (always in circuit) =============
fkey = pre_bypass * 7 + sr;
if (fkey != ck_fkey) {
	// quiescent point (no signal): source cap fully charged, so cdt = 0
	qi, qv = fet_step(0, 0, 0, RS, IDSS, VP);
	ck_idq = qi;
	ck_vsq = qv;
	ck_fkey = fkey;
	if (vs_state < 0) {
		vs_state = qv;
	}
}
sm_pre = psmooth(pre_bypass, ck_ps);         // F4 (v0.1.1): source cap switched over 10 ms
cdt = CS * sr * sm_pre;
vg = lp1(x, 15915) * VPF * ck_ig;            // input RF filter: 100k series, 100 pF to ground [S14]
id_n, vs_n = fet_step(vg, vs_state, cdt, RS, IDSS, VP);
vs_state = fixdenorm(vs_n);
// drain cannot fall below the source (+0.3 V): limits large positive swings
id_c = min(id_n, (VDD - vs_n - 0.3) / RD);
vac = (id_c - ck_idq) * RD;                  // drain AC (V); sign flipped so the device is non-inverting
pre = vac / VPF;                             // back to full-scale units (EP-3 gain kept)
// output mixer coefficients (recomputed only when Echo Volume moves)
if (sm_echo != ck_kkey) {
	gd, ge, rt = mixer(sm_echo);
	gd5, ge5, rt5 = mixer(0.5);
	ck_gd = gd;
	ck_ge = ge;
	ck_rth = rt;
	ck_en = gd5 / ge5;                       // echo source level: first repeat ~ dry level at k = 0.5 (APPROX)
	ck_kkey = sm_echo;
}
dry_br = hp1(pre, 7) * ck_gd * sm_dry;       // 0.1 uF coupling into ~260k: ~7 Hz

// ================= ECHO HEAD READ (fixed) =============================
ri = floor(p_new);
rf = p_new - ri;
i0 = wrap(ri, 0, L);
im1 = wrap(i0 - 1, 0, L);
ip1 = wrap(i0 + 1, 0, L);
ip2 = wrap(i0 + 2, 0, L);
m0 = peek(tape, im1, 0);
c0 = peek(tape, i0, 0);
n0 = peek(tape, ip1, 0);
q0 = peek(tape, ip2, 0);
y_echo = hermite(m0, c0, n0, q0, rf);
// SOS head (monitors the loop before it reaches the record head)
rs_pos = p_new + d_sos;
rsi = floor(rs_pos);
rsf = rs_pos - rsi;
j0 = wrap(rsi, 0, L);
jm1 = wrap(j0 - 1, 0, L);
jp1 = wrap(j0 + 1, 0, L);
jp2 = wrap(j0 + 2, 0, L);
sm0 = peek(tape, jm1, 0);
sc0 = peek(tape, j0, 0);
sn0 = peek(tape, jp1, 0);
sq0 = peek(tape, jp2, 0);
y_sos = hermite(sm0, sc0, sn0, sq0, rsf);

// ================= PLAYBACK CHAIN =====================================
gp = min(1, v_eff / 0.15);                   // head output falls away as the tape stops
fc_tape = clamp(5188 * v_eff, 50, 0.45 * sr); // tape HF loss: H&H fit (7782 Hz @ 12 ips) x 8/12  APPROX
yraw = y_echo * (1 - sos_s) + y_sos * sos_s; // SOS: you hear the SOS head [S1]
tl, tb_, th = svf(yraw * gp, fc_tape, 0.707);
// de-emphasis: 18k with 0.003 uF (forum, 2947 Hz) / 0.033 uF (manual scan, 268 Hz); both run and
// are crossfaded (F4). Each is normalised at 1 kHz so both give the same mid level.
y3 = lp1(tl, 2947);
y33 = lp1(tl, 268);
ypb = (y3 * sqrt(1 + (1000 / 2947) * (1000 / 2947))) * (1 - pbs) + (y33 * sqrt(1 + (1000 / 268) * (1000 / 268))) * pbs;
ypb = ypb * lg;                              // F6 fade
ypb = hp1(ypb, 30);                          // head-amp coupling APPROX
ypb = ypb + lp1(noise(), 10000) * ck_ng;
// F1 (v0.1.1): HOLD level trim. A fixed loop gain cannot freeze a loop: tape saturation
// compresses slightly at playing level and frequencies off the loop's peak decay. While HOLD
// is on, the playback power is compared with a target, and the hold gain is trimmed by at most
// +-3 % per pass. Settling: after HOLD is pressed the target may only fall (the loop darkens
// naturally but never grows) until the loop stops losing level (< 1 dB over a pass, at least
// 2 passes; at most 30 s); then it is locked and changes by Hold Feedback^2 per pass
// (1.0 = frozen), never sitting more than 1.5 dB above the loop's own level. Outside HOLD hold_c = 1 and nothing changes.
hp_env = fixdenorm(hp_env + (1 - exp(-1 / (0.3 * sr))) * (ypb * ypb - hp_env));
dsamp = max(d / max(vc, 0.000001), 1);
if (hold > 0.5 && hold_prev < 0.5) {
	hold_tgt = hp_env;
	hold_cnt = 30 * sr;                          // settling time limit (dark voicing needs the longest)
	hold_pass = dsamp + 0.3 * sr;                 // first check after one pass + envelope settle
	hold_np = 0;
	hold_elast = hp_env;
}
hold_prev = hold;
if (hold > 0.5) {
	if (hold_cnt > 0) {
		hold_tgt = min(hold_tgt, hp_env);
		hold_cnt = hold_cnt - 1;
		hold_pass = hold_pass - 1;
		if (hold_pass <= 0) {
			hold_np = hold_np + 1;
			if (hold_np >= 2 && hp_env > 0.794 * hold_elast) {
				hold_cnt = 0;                    // lost < 1 dB over the last pass: lock
			}
			hold_elast = hp_env;
			hold_pass = dsamp;
		}
		cc = (hold_tgt > 0.0000000001) ? clamp(sqrt(hold_tgt / max(hp_env, 0.00000000000000000001)), 0.97, 1) : 0.97;
	} else {
		hold_tgt = fixdenorm(hold_tgt * exp(2 * log(max(sm_hold_fb, 0.01)) / dsamp));
		// a shortfall beyond 1.5 dB is spectral loss (e.g. the dark voicing shedding its mids), not
		// saturation: let the target follow, so the trim never pumps the loop back up by more than 1.5 dB
		hold_tgt = min(hold_tgt, hp_env * 1.413);
		cc = (hold_tgt > 0.0000000001) ? clamp(sqrt(hold_tgt / max(hp_env, 0.00000000000000000001)), 0.97, 1.03) : 0.97;
	}
	hold_c = hold_c + (1 - exp(-1 / (0.2 * sr))) * (cc - hold_c);
} else {
	hold_c = hold_c + (1 - exp(-1 / (0.2 * sr))) * (1 - hold_c);
}
// Echo Sustain feedback, with the Echolivity feedback filters
f1l, f1b, f1h = svf(ypb, sm_fb_hp_hz, q_fb);
f2l, f2b, f2h = svf(f1h, sm_fb_lp_hz, q_fb);
guard = (env > 1.5) ? 1.5 / env : 1;
fbs = f2l * fb_amt * guard * dfb_g;
env = fixdenorm(env + ((abs(f2l * fb_amt) > env) ? ck_up : ck_dn) * (abs(f2l * fb_amt) - env));

// ================= RECORD CHAIN =======================================
u = pre * ck_rg * drive_gain * (1 - hold_s) + fbs;
u = hp1(u, 20);
u = tapesat(u * g_t * drive_gain, 0.05) / g_t;
u = dc_block(u);
// write anti-alias: the head's speed over the tape sets the tape's sample spacing
// spatial Nyquist: a frequency f lands at f / (|u_cps| sr) cycles per cell, which must stay < 0.5
// 4th-order Butterworth at 0.35 sr |u|: everything that plays back below 0.35 sr (16.8 kHz @ 48k)
// is kept; what would land above Nyquist is >= 40 dB down before the head samples it (test E03)
fc_w = clamp(0.35 * sr * abs(u_cps), 20, 0.45 * sr);
rl1, rb1, rh1 = svf(u, fc_w, 0.5412);
rl, rb, rh = svf(rl1, fc_w, 1.3066);
rec = fixnan(rl);

// ================= RECORD/ERASE HEAD: fill every cell crossed =========
// ECHO: erase + record (overwrite). SOS: erase off, new is added to the old
// layer, which loses sos_db per pass. PLAYBACK: record and erase off.
wr_gain = 1 - pb_s;
sp_bias = sm_bias_khz * 1000 / (max(abs(u_cps), 0.000001) * sr);  // bias cycles per tape cell
bias_amp = 0;
if (sp_bias < FBIAS_MIN_SP) {
	bias_amp = sm_bias_leak * 0.1 * min(1, (FBIAS_MIN_SP - sp_bias) / 0.1);   // level APPROX
}
if (wr_gain > 0.0001 && abs(u_cps) > 0.000001) {
	klo = (u_cps > 0) ? floor(w_old) + 1 : -floor(-w_new);      // -floor(-x) = ceil(x)
	khi = (u_cps > 0) ? floor(w_new) : -floor(-w_old) - 1;
	for (k = klo; k <= khi; k += 1) {
		f = (k - w_old) / u_cps;
		ki = wrap(k, 0, L);
		val = rec_prev + f * (rec - rec_prev);
		if (bias_amp > 0) {
			val = val + bias_amp * sin(twopi * sm_bias_khz * 1000 * ((t - 1 + f) / sr));
		}
		old = peek(tape, ki, 0);
		keep = sos_s * ck_sg;                            // SOS keeps the old layer
		nv = old * (1 - wr_gain) + wr_gain * (old * keep + val);
		poke(tape, nv, ki, 0);
	}
}
rec_prev = rec;
w_prev = w_new;
p = p_new;

// ================= OUTPUT =============================================
e1l, e1b, e1h = svf(ypb, sm_echo_hp_hz, 0.707);
e2l, e2b, e2h = svf(e1h, sm_echo_lp_hz, 0.707);
ech = dc_block(e2l) * echo_on_s2;
if (sm_out_db != ck_okey) {
	ck_og = pow(10, sm_out_db / 20);
	ck_okey = sm_out_db;
}
if (sm_echo_trim_db != ck_etkey) {
	ck_et = pow(10, sm_echo_trim_db / 20);
	ck_etkey = sm_echo_trim_db;
}
o_mix = dry_br + ech * ck_en * ck_ge * ck_et;
// F4 (v0.1.1): the cable filter always runs (no stale state); below 1 pF it is blended out
o_lp = lp1(o_mix, 1 / (twopi * ck_rth * max(sm_cable_pf, 1) * 0.000000000001));
if (sm_cable_pf >= 1) {
	o_mix = o_lp;
} else if (sm_cable_pf > 0) {
	o_mix = o_mix + sm_cable_pf * (o_lp - o_mix);
}
o1 = fixnan(o_mix * ck_og);
o2 = o1;

// ================= OUTPUT PROTECTION (as the H&H device) =================
if (ceiling_db != ck_ckey) {
	ck_cl = pow(10, ceiling_db / 20);
	ck_ckey = ceiling_db;
}
c_lin = ck_cl;
thr = c_lin * 0.944061;
pk = abs(o1);
over = (pk > thr) ? 1 : 0;
pg = 1;
if (protect > 0.5) {
	greq = (pk > thr) ? thr / pk : 1;
	if (greq < pg_hold) {
		pg_hold = greq;
		ph_cnt = 0.010 * sr;
	} else if (ph_cnt > 0) {
		ph_cnt = ph_cnt - 1;
	} else {
		pg_hold = pg_hold + ck_prel * (1 - pg_hold);
	}
	if (pg_hold < pg_s) {
		pg_s = pg_s + ck_patt * (pg_hold - pg_s);
	} else {
		pg_s = pg_hold;
	}
	pg = pg_s;
	o1 = softclip(o1 * pg, thr, c_lin);
	o2 = o1;
} else {
	pg_hold = 1;
	pg_s = 1;
	ph_cnt = 0;
}

out1 = o1;
out2 = o2;
out3 = (d / max(vc, 0.000000001)) / sr * 1000;
out4 = tap_bpm;
out5 = u_out;
out6 = v_eff;
out7 = pg;
out8 = over;
